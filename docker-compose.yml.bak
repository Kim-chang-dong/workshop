version: '3.8'

services:
  # ==============================================================================
  # 1. BROKER MQTT SÉCURISÉ (Eclipse Mosquitto - MQTTS 8883 & MQTT standard 1883)
  # ==============================================================================
  mqtt:
    image: eclipse-mosquitto:latest
    container_name: sentinel_mqtt
    restart: unless-stopped
    ports:
      - "1883:1883"   # MQTT standard (inter-conteneurs, dev local)
      - "8883:8883"   # MQTTS sécurisé TLS (pour ESP8266 & production)
    volumes:
      - ./mosquitto/config/mosquitto.conf:/mosquitto/config/mosquitto.conf
      - ./mosquitto/config/certs:/mosquitto/config/certs
      - ./mosquitto/config/passwd:/mosquitto/config/passwd
      - ./mosquitto/data:/mosquitto/data
      - ./mosquitto/log:/mosquitto/log
    networks:
      - sentinel_net

  # ==============================================================================
  # 2. BASE DE DONNÉES SÉRIES TEMPORELLES (TimescaleDB / PostgreSQL 15)
  # ==============================================================================
  timescaledb:
    image: timescale/timescaledb:latest-pg15
    container_name: sentinel_db
    restart: unless-stopped
    ports:
      - "5432:5432"
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-sentinel_user}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-sentinel_password}
      POSTGRES_DB: ${POSTGRES_DB:-sentinel_db}
    volumes:
      - db_data:/var/lib/postgresql/data
      - ./timescaledb/init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    networks:
      - sentinel_net

  # ==============================================================================
  # 3. API D'INGESTION MQTT -> TIMESCALEDB (Python)
  # ==============================================================================
  api_ingest:
    build:
      context: ./app
      dockerfile: Dockerfile
    container_name: sentinel_api_ingest
    restart: unless-stopped
    environment:
      MQTT_BROKER: mqtt
      MQTT_PORT: 1883
      MQTT_TOPIC: "sentinel/#"
      MQTT_USER: ${MQTT_USER:-esp_client}
      MQTT_PASSWORD: ${MQTT_PASSWORD:-SuperSecret123}
      DB_HOST: timescaledb
      DB_NAME: ${POSTGRES_DB:-sentinel_db}
      DB_USER: ${POSTGRES_USER:-sentinel_user}
      DB_PASSWORD: ${POSTGRES_PASSWORD:-sentinel_password}
    depends_on:
      - mqtt
      - timescaledb
    networks:
      - sentinel_net

  # ==============================================================================
  # 4. DASHBOARD DE SUPERVISION (Grafana avec auto-provisioning Datasource)
  # ==============================================================================
  grafana:
    image: grafana/grafana:latest
    container_name: sentinel_grafana
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: ${GRAFANA_ADMIN_USER:-admin}
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD:-sentinel_admin}
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
    depends_on:
      - timescaledb
    networks:
      - sentinel_net

  # ==============================================================================
  # 5. RECONNAISSANCE FACIALE & BIOMÉTRIE IA (YuNet + SFace + MediaPipe)
  # ==============================================================================
  biometric-vision:
    build:
      context: .
      dockerfile: Dockerfile
    image: biometric-vision:latest
    container_name: sentinel_biometric_vision
    restart: unless-stopped
    ports:
      - "5000:5000"
    environment:
      - PORT=5000
      - SIMILARITY_THRESHOLD=0.38
      - WEBCAM_SOURCE=${WEBCAM_SOURCE:-0}
      - MQTT_BROKER=mqtt
      - MQTT_PORT=1883
      - MQTT_USER=${MQTT_USER:-esp_client}
      - MQTT_PASSWORD=${MQTT_PASSWORD:-SuperSecret123}
    volumes:
      - ./faces_db:/app/faces_db
    # Sur Linux natif ou WSL2 avec usbipd pour attacher la webcam USB :
    devices:
      - /dev/video0:/dev/video0
    depends_on:
      - mqtt
    networks:
      - sentinel_net

volumes:
  db_data:
  grafana_data:

networks:
  sentinel_net:
    driver: bridge
