# ==============================================================================
# CONFIGURATION SENTINEL-X (Groupe 16)
# ==============================================================================

# PostgreSQL / TimescaleDB
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# MQTT Broker (Mosquitto)
MQTT_USER=
MQTT_PASSWORD=

# Grafana
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Vision / Caméra
# Sur Linux: /dev/video0 ou 0
# Sur Windows en conteneur: index 0 ou URL flux RTSP/HTTP (ex: http://192.168.1.50:8080/video)
WEBCAM_SOURCE=0

